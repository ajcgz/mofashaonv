          "body": {
            "type": "string"
          },
          "related": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "default": 0
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "updateEntry": {
        "desc": "修改百科詞條，需傳 id",
