{
  "$manifest": {
    "version": 1,
    "desc": "OC 世界觀資料：world / characters / relations / stories / places / events / gallery / entries（百科詞條）/ music（版面音樂）/ map",
    "queries": {
      "listMusic": {
        "desc": "查看音樂清單，可按版面過濾（page：all 或 home/characters/graph/timeline/map/gallery/wiki/stories）",
        "path": "music",
        "identity": "id",
        "params": {
          "page": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 100
      },
      "listEntries": {
        "desc": "查看百科詞條，可按分類過濾",
        "path": "entries",
        "identity": "id",
        "params": {
          "category": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 200
      },
      "getEntry": {
        "desc": "按 ID 取得單一詞條",
        "path": "entries",
        "identity": "id",
        "defaultLimit": 1
      },
      "listCharacters": {
        "desc": "查看人物，可按陣營過濾並排序",
        "path": "characters",
        "identity": "id",
        "params": {
          "faction": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 50
      },
      "getCharacter": {
        "desc": "按 ID 取得單個人物",
        "path": "characters",
        "identity": "id",
        "defaultLimit": 1
      },
      "listRelations": {
        "desc": "查看人物關係",
        "path": "relations",
        "identity": "id",
        "params": {
          "fromId": {
            "type": "string"
          },
          "toId": {
            "type": "string"
          },
          "type": {
            "type": "enum",
            "values": [
              "親屬",
              "摯友",
              "戀人",
              "師徒",
              "同盟",
              "敵對",
              "隸屬",
              "其他"
            ]
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 100
      },
      "listStories": {
        "desc": "查看背景故事列表",
        "path": "stories",
        "identity": "id",
        "params": {
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 50
      },
      "getStory": {
        "desc": "按 ID 取得單篇故事全文",
        "path": "stories",
        "identity": "id",
        "defaultLimit": 1
      },
      "listPlaces": {
        "desc": "查看地圖上的地點標點",
        "path": "places",
        "identity": "id",
        "params": {
          "category": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 100
      },
      "listEvents": {
        "desc": "按順序查看時間綫節點",
        "path": "events",
        "identity": "id",
        "params": {
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 100
      },
      "listGallery": {
        "desc": "查看畫廊圖片",
        "path": "gallery",
        "identity": "id",
        "params": {
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 100
      }
