    "mutations": {
      "addMusic": {
        "desc": "新增版面音樂，page 填 all 或 home/characters/graph/timeline/map/gallery/wiki/stories",
        "op": "append",
        "path": "music",
        "fields": {
          "title": {
            "type": "string"
          },
          "src": {
            "type": "string",
            "required": true
          },
          "page": {
            "type": "string",
            "default": "all"
          },
          "order": {
            "type": "integer",
            "default": 0
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "updateMusic": {
        "desc": "修改音樂資料，需傳 id",
        "op": "update",
        "path": "music",
        "match": "id",
        "fields": {
          "title": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      },
      "removeMusic": {
        "desc": "刪除音樂，需傳 id",
        "op": "remove",
        "path": "music",
        "match": "id"
      },
      "addEntry": {
        "desc": "新增百科詞條，body 內可用 [[詞條名]] 建立內鏈，related 為詞條 id 逗號分隔",
